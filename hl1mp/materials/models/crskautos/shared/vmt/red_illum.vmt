"VertexLitGeneric"
{
	 $basetexture "models/crskautos/shared/common/belyi"
"$bumpmap" "models/crskautos/shared/common/kraska_km"
"$nodecal" "1"
	"$phong" "1" 
	"$phongboost" "3.1" 
	"$phongfresnelranges" "[1 1 1]" 
	"$phongexponent" 55
	"$envmap" "env_cubemap"
	"$envmaptint" "[0.095 0.095 0.095]"
	"$colorfix" "{555 0 0}"
	"Proxies"
	{
		"Equals"
		{
			srcVar1 $colorfix
			resultVar	$color
		}
	}
}