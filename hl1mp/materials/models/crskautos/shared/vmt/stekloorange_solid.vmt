"VertexLitGeneric"
{

	$basetexture "models\crskautos\shared\common/steklo_oranzh"
"$bumpmap"    "models/crskautos/shared/common/steklo_km"
	"$envmap" env_cubemap
    "$halflambert" 1
	"$phong" "1" 
	"$phongboost" "4" 
	"$phongexponent" "50"
	"$phongfresnelranges" "[4 1 4]"
	"$surfaceprop" "Glass"
	"$envmapFresnel" "1"
	"$envmaptint" "[.0527 .0527 .0527]"
	"$carpenisenabled" "1"
	Proxies 
	{
		Equals 
		{
			srcVar1 $carpenisenabled
			resultVar	$color 
		}
	}
}



