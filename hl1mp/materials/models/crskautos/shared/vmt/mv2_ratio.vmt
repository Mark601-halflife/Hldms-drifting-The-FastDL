"VertexLitGeneric"
{

	$basetexture "models/crskautos/shared\police_rus/mv2_ratio"
"$bumpmap" "models/crskautos/shared\police_rus/mv2_ratio_n"
	"$nodecal" "1"
	"$phong" "1"
	"$phongexponent" "75"
	"$phongboost"	"2"
    "$envmapfresnel" "1.5"
	"$phongfresnelranges" "[.41 .72 .43]"
	"$envmaptint" "[0.5 0.5 0.5]"
	"$phongfix" "{22 22 22}"
    "$colorfix" "{255 255 255}"
	"Proxies"
	{
		"Equals"
		{
			srcVar1 $colorfix
			resultVar	$color
		}
	}
}