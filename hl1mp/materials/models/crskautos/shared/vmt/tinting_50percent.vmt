"VertexlitGeneric"
{
	"$basetexture" "models\crskautos\shared\with alpha\black_10_percent_alpha"
	"$bumpmap"    "models/crskautos/shared/common/steklo_km"
	"$envmap" env_cubemap
	"$translucent" 1
	"$nodecal" "1"
	"$phong" "1" 
	"$phongboost" "1" 
	"$phongexponent" "2"
	"$phongfresnelranges" "[0.015 0.38 3.2]"
	"$surfaceprop" "Glass"
	"$envmapFresnel" "1"
	"$envmaptint" "[1 1 1]"
	"$carpenisenabled" "1"
	"$colorfix" "{255 255 255}"
	"Proxies"
	{
		"Equals"
		{
			srcVar1 $colorfix
			resultVar	$color
		}
	}
}