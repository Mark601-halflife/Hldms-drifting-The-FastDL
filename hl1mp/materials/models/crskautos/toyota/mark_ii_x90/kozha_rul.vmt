"VertexLitGeneric"
{
    "$basetexturetransform" "center .5 .5 scale 45 45 rotate 0 translate 0 0"
    "$basetexture" "models/crskautos/shared/roof/roof_black"
    "$bumpmap" "models/crskautos/shared/roof/roof_normals"
    "$nodecal" "1"
    "$halflambert" 1
    "$phong" "1" 
    "$phongboost" ".13" 
    "$phongfresnelranges" "[1 1 1]" 
    "$phongexponent" 4.2
    "$envmap" "env_cubemap"
    "$envmaptint" "[0.0045 0.0045 0.0045]"
    "$rimlight" "1"
    "$rimlightexponent" "1.85"
    "$rimlightboost" "1"
    "$rimmask" "1"
    "$colorfix" "{252 218 220}"
	"Proxies"
	{
		"Equals"
		{
			srcVar1 $colorfix
			resultVar	$color
		}
	}
}


