"VertexLitGeneric"
{
    "$basetexturetransform" "center .5 .5 scale 75 75 rotate 0 translate 0 0"
    "$basetexture" "models/crskautos/shared/projectcars/common_carpet_black_diff"
    "$bumpmap" "models/crskautos/shared/projectcars/common_carpet_norm"
    "$nodecal" "1"
    "$phong" "1" 
    "$phongboost" ".1" 
    "$phongfresnelranges" "[.105 .12 .60]" 
    "$phongexponent" 1
    "$colorfix" "{120 120 120}"
	"Proxies"
	{
		"Equals"
		{
			srcVar1 $colorfix
			resultVar	$color
		}
	}
}
