"VertexLitGeneric"
{

	$basetexture "models\crskautos\toyota\mark_ii_x90/newinterlight"
"$bumpmap"    "models\crskautos\toyota\mark_ii_x90/newinterlight_n"
	"$envmap" env_cubemap
    "$halflambert" 1
	"$phong" "1" 
	"$phongboost" "4" 
	"$phongexponent" "50"
	"$phongfresnelranges" "[4 1 4]"
	"$surfaceprop" "Glass"
	"$envmapFresnel" "1"
	"$envmaptint" "[.0427 .0427 .0427]"
	"$carpenisenabled" "1"
	Proxies 
	{
		Equals 
		{
			srcVar1 $carpenisenabled
			resultVar	$color 
		}
	}
}
