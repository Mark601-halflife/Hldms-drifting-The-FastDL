"VertexLitGeneric"
{
"$basetexturetransform" "center .5 .5 scale 1 1 rotate 0 translate 0 0"
	$basetexture "models/crskautos/shared\wood/derevo"
"$bumpmap" "models/crskautos/shared/common/kraska_km"
"$nodecal" "1"
	"$phong" "1" 
	"$phongboost" "3.1" 
	"$phongfresnelranges" "[1 1 1]" 
	"$phongexponent" 55
	"$envmap" "env_cubemap"
	"$envmaptint" "[0.095 0.095 0.095]"
	"$colorfix" "{255 200 200}"
	"Proxies"
	{
		"Equals"
		{
			srcVar1 $colorfix
			resultVar	$color
		}
	}
}
