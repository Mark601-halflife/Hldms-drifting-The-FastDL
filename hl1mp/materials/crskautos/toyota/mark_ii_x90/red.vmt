"VertexLitGeneric"
{
	 $basetexture "models/crskautos/shared/common/belyi"
"$bumpmap" "models/crskautos/shared/common/kraska_km"
	"$nodecal" "1"
	"$phong" "1"
	"$phongexponent" "25"
	"$phongboost"	"3"
    "$envmapfresnel" "1.5"
	"$phongfresnelranges" "[.41 .72 .43]"
	"$envmaptint" "[0.5 0.5 0.5]"
	"$phongfix" "{22 22 22}"
    "$colorfix" "{200 200 200}"
	"Proxies"
	{
		"Equals"
		{
			srcVar1 $colorfix
			resultVar	$color
		}
	}
}