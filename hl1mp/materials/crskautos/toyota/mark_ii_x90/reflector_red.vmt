"VertexlitGeneric"
{
"$basetexturetransform" "center .5 .5 scale 4 1.5 rotate 0 translate 0 0"
	"$basetexture" "models/crskautos/shared/common/belyi"
	$bumpmap "models\crskautos\shared\normal\square_reflector"
"$nodecal" "1"
	"$phong" "1" 
	"$phongboost" "6" 
	"$phongfresnelranges" "[1.15 0.7 0.9]" 
	"$phongexponent" 11
	"$envmap" "env_cubemap"
	"$envmaptint" "[0.7 0.7 0.7]"
	"$halflambert" 1
	"$colorfix" "{255 0 0}"
	"Proxies"
	{
		"Equals"
		{
			srcVar1 $colorfix
			resultVar	$color
		}
	}
}





