"VertexLitGeneric"
{
    "$basetexturetransform" "center .5 .5 scale 7 7 rotate 0 translate 0 0"
	$basetexture "models/crskautos/shared/grille/mesh2_mediumgrey"
    "$bumpmap" "models/crskautos/shared/grille/mesh2_normals"
    "$nodecal" "1"
	"$halflambert" 1
    "$phong" "1" 
	"$phongboost" ".13" 
	"$phongfresnelranges" "[1 1 1]" 
	"$phongexponent" 5
	"$rimlight" "1"
	"$rimlightexponent" "2"
	"$rimlightboost" "1"
	"$rimmask" "1"
	"$envmap" "env_cubemap"
	"$envmaptint" "[0.005 0.005 0.005]"
    "$colorfix" "{100 100 100}"
	"Proxies"
	{
		"Equals"
		{
			srcVar1 $colorfix
			resultVar	$color
		}
	}
}