"VertexlitGeneric"
{
"$basetexturetransform" "center .5 .5 scale 4 4 rotate 0 translate 0 0"
	"$basetexture" "models/crskautos/shared/common/hrom"
	$bumpmap "models\crskautos\shared\normal\square_reflector"
	"$normalmapalphaenvmapmask" 1
	"$nocull" "1"
"$nodecal" "1"
	"$phong" "1" 
	"$phongboost" "6" 
	"$phongfresnelranges" "[1.15 0.7 0.9]" 
	"$phongexponent" 11
	"$envmap" "env_cubemap"
	"$envmaptint" "[3 3 3]"
	"$halflambert" 1
	"$colorfix" "{50 50 50}"
	"$rimlight" "1"
	"$rimlightexponent" "1"
	"$rimlightboost" "1"
	"$rimmask" "1"
	"Proxies"
	{
		"Equals"
		{
			srcVar1 $colorfix
			resultVar	$color
		}
	}
}