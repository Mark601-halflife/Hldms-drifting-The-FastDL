"VertexLitGeneric"
{
    "$basetexturetransform" "center .5 .5 scale 120 120 rotate 0 translate 0 0"
    "$basetexture" "models/crskautos/shared/projectcars/common_alcantara01_mediumgrey_diff"
    "$bumpmap" "models/crskautos/shared/projectcars/common_alcantara01_norm"
    "$nodecal" "1"
    "$phong" "1" 
    "$phongboost" ".055" 
    "$phongfresnelranges" "[.15 .12 .45]" 
    "$phongexponent" 1.85
    "$detail" "models/crskautos/shared/projectcars/common_alcantara_spec"
